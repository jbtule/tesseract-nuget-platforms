<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Packs the compiled vendor/tesseract wrapper assembly (built separately,
    see release.yml) under our own package identity, id/version/etc. from
    -p:NuspecProperties. We don't `dotnet pack` vendor/tesseract's own
    csproj directly: it bundles charlesw's stale Windows-only binaries
    straight into the package (committed x64\*.dll / x86\*.dll), which
    we don't want alongside our own fresh cross-platform native packages.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <NoWarn>$(NoWarn);NU5128;CS8017</NoWarn>
    <NuspecFile>Tesseract.CrossPlatform.nuspec</NuspecFile>
    <NuspecBasePath>$(MSBuildProjectDirectory)</NuspecBasePath>
  </PropertyGroup>

</Project>
