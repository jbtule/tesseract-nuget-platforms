<?xml version="1.0" encoding="utf-8"?>
<package>
  <metadata>
    <id>Tesseract.CrossPlatform</id>
    <version>$version$</version>
    <authors>jay@tuley.name</authors>
    <description>
      charlesw/tesseract's .NET wrapper for Tesseract OCR, built from a
      patched fork (jbtule/Tesseract.CrossPlatform-dotnet, master branch) with several
      native-library-loading fixes -- works cross-platform with zero setup
      after a normal `dotnet publish -r &lt;rid&gt;`. Depends on
      Tesseract.Native, so installing this one package restores the
      matching native binaries for whichever of
      win-x64/win-arm64/linux-x64/osx-arm64 you're building for.

      Source-compatible replacement for the stock Tesseract package for
      typical usage -- same namespace and types -- but requires
      net8.0/net9.0/net10.0 (the stock package also supports
      netstandard2.0/net47/net48), and two protected members
      (PageIterator.handle, ResultRenderer.Handle) changed type from
      HandleRef to this fork's own NativeHandle. Install this INSTEAD OF
      Tesseract, not alongside it.
    </description>
    <license type="expression">Apache-2.0</license>
    <projectUrl>$repoUrl$</projectUrl>
    <repository type="git" url="$repoUrl$" />
    <tags>tesseract ocr cross-platform arm64</tags>
    <readme>README.md</readme>
    <dependencies>
      <group targetFramework="net8.0">
        <dependency id="Tesseract.Native" version="$version$" />
      </group>
      <group targetFramework="net9.0">
        <dependency id="Tesseract.Native" version="$version$" />
      </group>
      <group targetFramework="net10.0">
        <dependency id="Tesseract.Native" version="$version$" />
      </group>
    </dependencies>
  </metadata>
  <!--
    The built assembly is named Tesseract.CrossPlatform.dll, not
    Tesseract.dll, even though its namespace/types are still exactly
    "Tesseract.*" (an -p:AssemblyName override at build time, not a
    fork/source change, see the wrapperBuild-generating dotnet build
    commands in scripts/smoketest.sh and release.yml). Necessary: on a
    case-insensitive filesystem (Windows), a generic native "tesseract.dll"
    alias (see the vendored fix's Constants.cs) and this managed assembly
    would otherwise both want the exact same output filename, which
    dotnet publish correctly refuses as a real conflict, not a false
    positive, confirmed via a real NETSDK1152 "multiple publish output
    files with the same relative path" failure. Only the DLL/PDB are
    renamed by the AssemblyName override; the XML doc comments file keeps
    its original built name (the upstream .csproj hardcodes
    <DocumentationFile>, so it doesn't follow AssemblyName), renamed here
    instead via the nuspec's own target filename.
  -->
  <files>
    <file src="$wrapperBuild$/net8.0/Tesseract.CrossPlatform.dll" target="lib/net8.0/" />
    <file src="$wrapperBuild$/net8.0/Tesseract.xml" target="lib/net8.0/Tesseract.CrossPlatform.xml" />
    <file src="$wrapperBuild$/net9.0/Tesseract.CrossPlatform.dll" target="lib/net9.0/" />
    <file src="$wrapperBuild$/net9.0/Tesseract.xml" target="lib/net9.0/Tesseract.CrossPlatform.xml" />
    <file src="$wrapperBuild$/net10.0/Tesseract.CrossPlatform.dll" target="lib/net10.0/" />
    <file src="$wrapperBuild$/net10.0/Tesseract.xml" target="lib/net10.0/Tesseract.CrossPlatform.xml" />
    <file src="nuget/wrapper/README.md" target="README.md" />
  </files>
</package>
