<?xml version="1.0" encoding="utf-8"?>
<package>
  <metadata>
    <id>$id$</id>
    <version>$version$</version>
    <authors>jay@tuley.name</authors>
    <description>Native Tesseract OCR + Leptonica shared libraries for $rid$, built via vcpkg ($vcpkgRef$) in GitHub Actions. Intended for use with charlesw/tesseract's TesseractEnviornment.CustomSearchPath, or any consumer that restores a runtimes/$rid$/native asset. You normally want the Tesseract.Native meta-package instead of this one directly.</description>
    <license type="expression">Apache-2.0</license>
    <projectUrl>$repoUrl$</projectUrl>
    <repository type="git" url="$repoUrl$" />
    <tags>tesseract leptonica ocr native runtime $rid$</tags>
    <readme>README.md</readme>
  </metadata>
  <files>
    <!--
      No globs here on purpose. NuGet's glob-to-target path computation for
      a wildcard src has proven unreliable specifically when dotnet pack
      runs on Windows: a recursive globbed src duplicated the source
      directory structure under target, and a single-level globbed src
      matched nothing at all, while the identical patterns packed
      correctly from macOS/Linux either way. NATIVE_FILES/LICENSE_FILES
      are placeholders: the packing script generates one explicit,
      absolute, non-wildcard file entry per actual file and inserts it
      here instead, which has no cross-platform glob ambiguity to hit in
      the first place.
    -->
    <!-- NATIVE_FILES_PLACEHOLDER -->
    <!-- LICENSE_FILES_PLACEHOLDER -->
    <file src="nuget/runtime/README.md" target="README.md" />
  </files>
</package>
