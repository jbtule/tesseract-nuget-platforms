<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- Tesseract.CrossPlatform and Tesseract.Native.browser-wasm are both
         real, published releases (confirmed on nuget.org) - no local-feed/
         local-global-cache indirection needed here. The comment this
         replaced pointed at a hardcoded personal machine path
         (/Users/jay/.nuget/packages), which only ever worked on that one
         machine - confirmed broken for real in CI (NU1301: "local source
         ... doesn't exist"). -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
