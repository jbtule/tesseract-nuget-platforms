<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- Tesseract.CrossPlatform/Tesseract.Native aren't on nuget.org - reuse whatever's
         already extracted in the local global-packages cache (see
         vendor/tesseract/src/Tesseract.Tests.AnyUnit/nuget.config's own identical
         approach), rather than the real scripts/unittest-wasm.sh's throwaway-temp-feed
         dance (this project is built directly, not through that script). -->
    <add key="local-global-cache" value="/Users/jay/.nuget/packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
