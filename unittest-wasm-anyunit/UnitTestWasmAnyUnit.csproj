<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <!--
    Replaces unittest-wasm/UnitTestWasm.csproj's hand-rolled NUnit-internal-API
    reflection hack (WorkItemBuilder/WorkItem.RunOnCurrentThread, needed because
    real NUnit's own Run()/EventPump path unconditionally spins up a background
    thread, fatal under Mono's single-threaded wasm - see that project's own
    comment) with AnyUnit.Runner.Bootstrap: Test.cs already runs inline under a
    single-threaded runtime (Utility.IsSingleThreadedRuntime), no internal-API
    reflection needed - just a plain console Main, run under node/bun, no
    headless browser/Playwright/dev-server HTTP-fetch dance needed either
    (dotnet.js detects a non-browser JS host and boots directly - see
    Runner/Platforms/browser-wasm-runner-host/Readme.md in AnyUnit's own repo).

    Source-includes Tesseract.Tests's/Tesseract.Tests.SkiaSharp's own .cs files
    directly (not ProjectReference - confirmed the hard way that referencing
    both together in one graph breaks: Tesseract.Tests pulls in Tesseract.Drawing,
    which needs System.Drawing.Common, no wasm support at all; and Tesseract.
    Tests/Tesseract.Tests.SkiaSharp need Tesseract.csproj built under two
    different assembly identities - "Tesseract" vs "Tesseract.CrossPlatform" -
    simultaneously, which a single build graph can't do). Same shape
    UnitTestWasm.csproj's own comment already describes for the identical
    reason, just for both files this time instead of only ConvertBitmapToPixTests.cs/
    ColorTests.cs.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <WasmNativeStrip>false</WasmNativeStrip>
    <WasmAllowUndefinedSymbols>true</WasmAllowUndefinedSymbols>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Matches Tesseract.CrossPlatform's InternalsVisibleTo("Tesseract.Tests")
         grant (see vendor/tesseract's own AssemblyInfo.cs) - same convention
         UnitTestWasm.csproj's own AssemblyName already used, for the same
         reason (BaseApiTests reaches internal API surface). -->
    <AssemblyName>Tesseract.Tests</AssemblyName>
    <RootNamespace>UnitTestWasmAnyUnit</RootNamespace>
    <IsPackable>false</IsPackable>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.11" />
    <!-- Pinned to match versions.env's PACKAGE_VERSION - the real scripts/unittest-wasm.sh
         passes -p:PackageVersion=$PACKAGE_VERSION on the command line instead; hardcoded
         here since this project is built directly (dotnet build, no wrapper script) and an
         unset $(PackageVersion) silently falls back to whatever's newest on the configured
         feed, which isn't necessarily this repo's own just-packed build. -->
    <PackageReference Include="Tesseract.CrossPlatform" Version="5.5.2.200" />
    <PackageReference Include="nunit" Version="4.6.1" />
    <PackageReference Include="SkiaSharp" Version="4.152.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.WebAssembly" Version="4.152.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Real 1.0.0 release from nuget.org now, not a local checkout. -->
    <PackageReference Include="AnyUnit" Version="1.0.0" />
    <PackageReference Include="AnyUnit.Style.Nunit" Version="1.0.0" />
    <PackageReference Include="AnyUnit.Runner.Bootstrap" Version="1.0.0" />
  </ItemGroup>

  <ItemGroup>
    <NativeFileReference Include="..\stage\browser-wasm\native\tesseract.a" />
    <NativeFileReference Include="..\stage\browser-wasm\native\leptonica.a" />
  </ItemGroup>

  <!--
    ConvertBitmapToPixTests.cs/ColorTests.cs excluded: both need System.Drawing.Common,
    no wasm support at all - same exclusion UnitTestWasm.csproj's own comment describes.
  -->
  <ItemGroup>
    <Compile Include="..\vendor\tesseract\src\Tesseract.Tests\**\*.cs"
             Exclude="
               ..\vendor\tesseract\src\Tesseract.Tests\**\obj\**\*.cs;
               ..\vendor\tesseract\src\Tesseract.Tests\**\bin\**\*.cs;
               ..\vendor\tesseract\src\Tesseract.Tests\Leptonica\ConvertBitmapToPixTests.cs;
               ..\vendor\tesseract\src\Tesseract.Tests\Leptonica\ColorTests.cs;
               ..\vendor\tesseract\src\Tesseract.Tests\Program.cs"
             Link="TesseractTests\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!--
    GlobalTestSetup.cs excluded here: this project already gets the same
    [SetUpFixture] from Tesseract.Tests's own copy above (same namespace,
    Tesseract.Tests), so including Tesseract.Tests.SkiaSharp's own duplicate
    would just be a second, redundant [SetUpFixture] doing the identical
    thing (see that project's own csproj comment for why it has its own
    copy at all - not needed once both are compiled into one assembly).
  -->
  <ItemGroup>
    <Compile Include="..\vendor\tesseract\src\Tesseract.CrossPlatform.SkiaSharp\**\*.cs"
             Exclude="
               ..\vendor\tesseract\src\Tesseract.CrossPlatform.SkiaSharp\**\obj\**\*.cs;
               ..\vendor\tesseract\src\Tesseract.CrossPlatform.SkiaSharp\**\bin\**\*.cs"
             Link="TesseractSkiaSharp\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\vendor\tesseract\src\Tesseract.Tests.SkiaSharp\ConvertSkiaBitmapToPixTests.cs"
             Link="TesseractTestsSkiaSharp\ConvertSkiaBitmapToPixTests.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="wwwroot\index.html" CopyToOutputDirectory="PreserveNewest" Link="wwwroot\index.html" />
    <None Include="wwwroot\runtests.mjs" CopyToOutputDirectory="PreserveNewest" Link="wwwroot\runtests.mjs" />
    <None Include="wwwroot\package.json" CopyToOutputDirectory="PreserveNewest" Link="wwwroot\package.json" />
  </ItemGroup>

  <!--
    Fixture files staged into the output directory (not the wasm virtual FS
    directly - runtests.mjs injects them into that at boot, via Module.FS,
    from these copied files, same as QrLinkPdf.Tests.Wasm's own tessdata
    convention).
  -->
  <ItemGroup>
    <None Include="..\vendor\tesseract\src\Tesseract.Tests\Data\**\*.*" CopyToOutputDirectory="PreserveNewest" Link="fixtures\Data\%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="..\vendor\tesseract\src\Tesseract.Tests\Results\**\*.*" CopyToOutputDirectory="PreserveNewest" Link="fixtures\Results\%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="..\vendor\tesseract\src\Tesseract.Tests\tessdata\**\*.*" CopyToOutputDirectory="PreserveNewest" Link="fixtures\tessdata\%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- Tesseract.Tests.SkiaSharp's own two fixtures are already covered by
         Tesseract.Tests\Data above - that project links the same two files
         from there rather than keeping its own copy (see its own csproj). -->
    <None Include="..\versions.env" CopyToOutputDirectory="PreserveNewest" Link="fixtures\versions.env" />
  </ItemGroup>

</Project>
