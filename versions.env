# Single source of truth for what this repo builds and what version the
# resulting NuGet packages get. Bump these, push a `v<PACKAGE_VERSION>` tag,
# and the release workflow builds + publishes.

# Upstream source tags to build.
LEPTONICA_VERSION=1.85.0
TESSERACT_VERSION=5.5.0

# NuGet package version. Convention: track TESSERACT_VERSION, add a 4th
# segment if we need to re-cut a release without bumping tesseract itself
# (e.g. a packaging-only fix).
PACKAGE_VERSION=5.5.0
