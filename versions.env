# Single source of truth for what this repo builds and what version the
# resulting NuGet packages get. Bump these, push a `v<PACKAGE_VERSION>` tag,
# and the release workflow builds + publishes.

# vcpkg registry tag/commit to build tesseract+leptonica from. We consume
# vcpkg's own tesseract/leptonica ports (see scripts/build-native.sh) rather
# than building from upstream source ourselves, so this -- not a tesseract
# or leptonica tag -- is what actually pins the versions we ship. Pinned
# (rather than floating on vcpkg's default branch) so a re-run of the same
# commit reproduces the same build. Check
# https://github.com/microsoft/vcpkg/blob/<ref>/ports/tesseract/vcpkg.json
# to see exactly which tesseract version a given ref resolves to.
VCPKG_REF=2026.07.29

# NuGet package version: <tesseract-version>.<packaging-revision>. The
# first 3 segments should match the tesseract version vcpkg resolves at
# VCPKG_REF above (check the CI log for "tesseract/leptonica versions from
# vcpkg ..." to confirm, since VCPKG_REF doesn't pin an exact tesseract
# version by itself). The 4th segment increments for a packaging/wrapper-only
# fix release against that *same* underlying tesseract version -- e.g.
# 5.5.2 was unlisted for a real bug (missing native dependencies, wrong
# hardcoded DLL names), fixed with no change to VCPKG_REF, so the fix
# shipped as 5.5.2.1, not a reset. Reset the 4th segment to 0 (or omit it)
# whenever the first 3 segments change because VCPKG_REF moved.
PACKAGE_VERSION=5.5.2.2

# browser-wasm build inputs (scripts/build-native-wasm.sh) -- separate from
# VCPKG_REF above because vcpkg's tesseract port excludes Emscripten
# entirely ("supports": "!emscripten", confirmed in the WASM backlog plan's
# Phase 0), so this RID builds from upstream source/tags directly instead of
# via vcpkg. LEPTONICA_WASM_REF/TESSERACT_WASM_REF are upstream release
# tags, kept in sync by hand with whatever VCPKG_REF resolves to for the
# other 5 RIDs (check each job's CI log, or a local
# `vcpkg install tesseract --triplet ...` run, for the exact versions vcpkg
# picked) so browser-wasm ships the same tesseract/leptonica version as
# everyone else. EMSDK_REF is the exact Emscripten version the target TFM's
# wasm-tools workload expects (net10.0 -> 3.1.56, confirmed via the
# installed Microsoft.NET.Runtime.Emscripten.3.1.56.* packs) -- load-bearing,
# not a convenience pin: a mismatched Emscripten version's statically-linked
# output isn't guaranteed compatible with the .NET wasm runtime it gets
# linked into.
LEPTONICA_WASM_REF=1.87.0
TESSERACT_WASM_REF=5.5.2
EMSDK_REF=3.1.56
